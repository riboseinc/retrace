    "agent_id",
    "policy_epoch"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "policy_epoch": {
      "type": "integer"
    },
    "applied_ms": {
      "type": "integer"
    },
    "policy.unsigned": {
      "type": "boolean"
    },
    "failed": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
