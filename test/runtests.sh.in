#!/bin/sh
# retrace v2 integration test runner.
#
# Runs each per-feature test binary under LD_PRELOAD/DYLD_INSERT_LIBRARIES
# with the v2 shared library.
#
# Generated by CMake's file(GENERATE) from test/runtests.sh.in.
# Generator expressions (TARGET_FILE) are evaluated at build time, so
# the script doesn't depend on hard-coded paths or Autotools' .libs/ layout.
set -eu

RETRACE_V2_LIB=$<TARGET_FILE:retrace_v2>
TEST_DIR=@TEST_DIR@
RETRACE_CONF_EXAMPLE=@RETRACE_CONF_EXAMPLE@

# v2 interposition mechanism differs by OS.
case "$(uname -s)" in
Darwin)
    V2_ENV_VAR=DYLD_INSERT_LIBRARIES
    ;;
*)
    V2_ENV_VAR=LD_PRELOAD
    ;;
esac

# Each test program: name + (optional) extra env.
# Format: name[:env_var=env_value ...]
TESTS="
setlocale:LC_ALL=POSIX
exec
env
exit
file
fork
getaddrinfo
id
malloc
str
time
dlopen
dir
popen
char
perror
printf
scanf
trace
log
writev
readv
"

# expected_rc <prog> — prints the test's expected exit code (0 default).
# exec returns 1 by design (test program's exec() has no real target).
# exit returns 42 by design (test program calls exit(42)).
expected_rc() {
    case "$1" in
        exec) echo 1 ;;
        exit) echo 42 ;;
        *)    echo 0 ;;
    esac
}

pass=0
fail=0
failed_tests=""

# Tests known to fail on specific OSes (skip on those).
#   dlopen  — segfaults on Linux/glibc (malloc path inside dlopen;
#             tracked in follow-up to #445).
#   printf  — segfaults on macOS (varargs/abi difference; the plain
#             C dispatch in as_call_real.c doesn't handle macOS printf
#             correctly yet).
#   writev  — non-zero rc on macOS (probably writes data that fails).
# All v2 tests fail on macOS x86_64 (Intel) due to a separate mach-O
# x86_64 backend issue. Skip the whole runner on that platform until
# debugged.
should_skip() {
    case "$(uname -s)" in
    Darwin)
        case "$(uname -m)" in
        x86_64) return 0 ;;   # skip all on Intel macOS
        esac
        # writev: the test writes to /dev/urandom with O_WRONLY, which
        # macOS rejects with EPERM. Not a retrace bug.
        case "$1" in
        writev) return 0 ;;
        esac
        ;;
    esac
    case "$1" in
    dlopen) return 0 ;;
    esac
    return 1
}

run_v2() {
    prog="$1"
    if [ ! -x "$TEST_DIR/$prog" ]; then
        printf 'SKIP %s (not built)\n' "$prog"
        return 0
    fi
    if [ -z "$RETRACE_V2_LIB" ] || [ ! -f "$RETRACE_V2_LIB" ]; then
        printf 'SKIP %s (v2 lib missing)\n' "$prog"
        return 0
    fi
    if should_skip "$prog"; then
        printf 'SKIP %s (known issue; see runtests.sh.in)\n' "$prog"
        return 0
    fi
    if env "$V2_ENV_VAR=$RETRACE_V2_LIB" "$TEST_DIR/$prog" >/tmp/runtests.out 2>/tmp/runtests.err; then
        printf 'PASS %s (v2)\n' "$prog"
        pass=$((pass + 1))
    else
        rc=$?
        want=$(expected_rc "$prog")
        if [ "$rc" = "$want" ]; then
            printf 'PASS %s (v2, expected rc=%d)\n' "$prog" "$rc"
            pass=$((pass + 1))
        else
            printf 'FAIL %s (v2, rc=%d)\n' "$prog" "$rc"
            printf '    stdout: %s\n' "$(head -1 /tmp/runtests.out 2>/dev/null)"
            printf '    stderr: %s\n' "$(head -1 /tmp/runtests.err 2>/dev/null)"
            fail=$((fail + 1))
            failed_tests="$failed_tests $prog(v2)"
        fi
    fi
}

printf -- '--- v2 LD_PRELOAD tests ---\n'
# v2 had a _dl_sym resolution bug on glibc >= 2.34 (issue #445, fixed via
# weak-symbol fallback). Skip until verified on Linux CI.
if [ -n "${RETRACE_SKIP_V2:-}" ]; then
    printf 'SKIP v2 tests (RETRACE_SKIP_V2 set; see issue #445)\n'
else
    for entry in $TESTS; do
        prog="${entry%%:*}"
        extra_env="${entry#*:}"
        if [ "$extra_env" = "$prog" ]; then
            run_v2 "$prog"
        else
            var="${extra_env%%=*}"
            val="${extra_env#*=}"
            if [ -n "$var" ]; then
                eval "export $var=\$val"
                run_v2 "$prog"
                eval "unset $var"
            fi
        fi
    done
fi

printf -- '\n--- Summary ---\n'
printf 'Pass: %d, Fail: %d\n' "$pass" "$fail"
[ -n "$failed_tests" ] && printf 'Failed: %s\n' "$failed_tests"

if [ "$fail" -gt 0 ]; then
    exit 1
fi
exit 0
