---
/*
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * Wrapper section that hosts the Wizard.vue island. Sits between
 * TutorialPaths and Tutorials in the page flow (TODO.complete/36 P0).
 */
import Wizard from "../components/Wizard.vue";
---

<section id="wizard" class="section">
  <div class="container">
    <h2>Not sure where to start?</h2>
    <p class="lede">
      Answer three questions and we'll generate the right config + command for your use case.
    </p>
    <Wizard client:visible />
  </div>
</section>

<style>
.section {
  padding: 64px 0;
  background: var(--surface, #f8f9fa);
  border-top: 1px solid var(--border, #ecf0f1);
}
.container {
  max-width: 960px;
  margin: 0 auto;
  padding: 0 24px;
}
h2 {
  font-size: 28px;
  margin-bottom: 8px;
}
.lede {
  font-size: 16px;
  color: var(--muted, #6c7a89);
  margin-bottom: 32px;
}
</style>
