---
const rows = [
  { cap: "Observe libc calls", retrace: "yes", strace: "yes", frida: "yes", lf: "no" },
  { cap: "Modify arguments", retrace: "yes", strace: "no", frida: "yes", lf: "no" },
  { cap: "Override return value", retrace: "yes", strace: "no", frida: "yes", lf: "no" },
  { cap: "Fault injection (OOM, short I/O)", retrace: "built-in", strace: "no", frida: "partial", lf: "yes" },
  { cap: "No source code needed", retrace: "yes", strace: "yes", frida: "no", lf: "no" },
  { cap: "No recompilation", retrace: "yes", strace: "yes", frida: "yes", lf: "no" },
  { cap: "Cross-platform", retrace: "13 platforms", strace: "no", frida: "partial", lf: "partial" },
  { cap: "Binary size", retrace: "~200 KB", strace: "preinstalled", frida: "~40 MB", lf: "linked in" },
  { cap: "Declarative config", retrace: "JSON / CLI", strace: "no", frida: "no", lf: "no" },
];

function cellClass(v) {
  if (v === "yes") return "yes";
  if (v === "no") return "no";
  if (v === "partial") return "partial";
  return "num";
}
function cellText(v) {
  if (v === "yes") return "✓";
  if (v === "no") return "—";
  return v;
}
---

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">How it compares</div>
      <h2>Observe <em>and</em> mutate, without writing code.</h2>
      <p>
        The existing tools each do part of the job. strace observes but cannot mutate. Frida mutates but
        requires JavaScript. libFuzzer mutates but requires recompilation. retrace is the only one that
        does all three on a binary you didn't build.
      </p>
    </div>

    <table class="compare-table reveal">
      <thead>
        <tr>
          <th>Capability</th>
          <th class="retrace-col">retrace</th>
          <th>strace</th>
          <th>Frida</th>
          <th>libFuzzer</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td class="cap">{r.cap}</td>
              <td class={`retrace-col ${cellClass(r.retrace)}`}>{cellText(r.retrace)}</td>
              <td class={`tool ${cellClass(r.strace)}`}>{cellText(r.strace)}</td>
              <td class={`tool ${cellClass(r.frida)}`}>{cellText(r.frida)}</td>
              <td class={`tool ${cellClass(r.lf)}`}>{cellText(r.lf)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
.compare-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13.5px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 14px;
  overflow: hidden;
  background: rgba(20, 24, 30, 0.4);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
}
.compare-table th, .compare-table td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}
.compare-table tr:last-child td { border-bottom: none; }
.compare-table th {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-dim);
  background: rgba(7, 9, 13, 0.5);
}
.compare-table th.retrace-col { color: var(--color-see); }
.compare-table td.cap { color: var(--color-text); }
.compare-table td.tool {
  color: var(--color-dim);
  font-family: var(--font-mono);
  font-size: 12.5px;
  text-align: center;
}
.compare-table td.yes { color: var(--color-see); }
.compare-table td.no { color: var(--color-dim); }
.compare-table td.partial { color: var(--color-control); }
.compare-table td.num { font-family: var(--font-mono); font-size: 12px; }
.compare-table td.retrace-col { background: rgba(94, 227, 255, 0.04); }
</style>
