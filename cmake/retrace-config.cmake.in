#
# retrace-config.cmake — package config for find_package(retrace).
# See TODO.roadmap/07-packaging-distribution.md.
#
# Once per-layer targets are exported, this file imports them:
#   retrace::core, retrace::backend-preload-elf, etc.

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/retraceTargets.cmake")

set(retrace_VERSION "@PROJECT_VERSION@")

# Compatibility: callers can do find_package(retrace 2.0 REQUIRED)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(OpenSSL)

check_required_components(retrace)
