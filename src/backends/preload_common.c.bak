/*
 * Shared spawn helper for LD_PRELOAD-style backends (Linux, BSD, macOS
 * uses its own due to DYLD_*). fork + execv with the appropriate env
 * var set.
 *
 * See TODO.v2/05-backend-abstraction.md.
 */

#include <retrace/backend.h>

#include <stdlib.h>
#include <string.h>
#include <sys/wait.h>
#include <unistd.h>
#include <errno.h>

extern char **environ;

/*
 * Spawn target with lib_path injected via env_var_name.
 *
 * env_var_name: "LD_PRELOAD" on Linux/BSD, "DYLD_INSERT_LIBRARIES" on macOS.
 * lib_path: full path to the retrace_v2 shared library.
 */
pid_t
retrace_preload_spawn_common(const char *env_var_name,
                              const char *lib_path,
                              const char *target_path,
                              char *const argv[],
                              char *const envp[])
{
	pid_t pid;
	int status;
	char *const *use_env = envp ? envp : environ;

	(void)env_var_name;

	pid = fork();
	if (pid == 0) {
		/* Child: set env and exec. */
		setenv(env_var_name, lib_path, 1);
		execv(target_path, argv);
		_exit(127);
	} else if (pid < 0) {
		return RETRACE_BACKEND_INTERNAL;
	}

	/* Parent: wait for child to exit. */
	while (waitpid(pid, &status, 0) == -1 && errno == EINTR)
		;

	return pid;
}

/*
 * Detect the retrace_v2 library path. Priority:
 *   1. RETRACE_V2_LIB env var (explicit override)
 *   2. Hard-coded system paths (/usr/local/lib, /usr/lib)
 */
const char *
retrace_preload_detect_lib(const char *filename)
{
	const char *explicit = getenv("RETRACE_V2_LIB");
	if (explicit != NULL)
		return explicit;

	static const char *const dirs[] = {
		"/usr/local/lib", "/usr/lib", NULL,
	};
	static char path[256];
	size_t i;

	for (i = 0; dirs[i] != NULL; i++) {
		snprintf(path, sizeof(path), "%s/%s", dirs[i], filename);
		if (access(path, R_OK) == 0)
			return path;
	}
	return NULL;
}
